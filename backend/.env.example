# DeepGuard AI - Cloud Environment Configuration
# Project: DeepGuard AI (Capstone Group K3C0175 / SIH1683)
# Architect: Mohan Abhishek Gupta (Cloud & System Architecture)

# General API Configuration
PROJECT_NAME="DeepGuard AI Backend Orchestrator"
PROJECT_VERSION="1.0.0"
GROUP_CODE="K3C0175"
SIH_PROBLEM_ID="SIH1683"
ENVIRONMENT="development"
DEBUG=true

# Storage Settings
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=100

# AWS S3 Cloud Storage Credentials (Leave empty to use local hybrid storage fallback)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=deepguard-multimodal-evidence-storage

# Worker & Orchestrator Configuration
WORKER_CONCURRENCY=4
ANALYSIS_TIMEOUT_SECONDS=120

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000", "http://127.0.0.1:8000"]
